{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "dmg/read-more",
	"version": "0.1.0",
	"title": "DMG Read More",
	"category": "widgets",
	"icon": "admin-links",
	"description": "Displays a Read More link to another published post.",
	"example": {},
	"attributes": {
		"postId": {
			"type": "integer"
		},
		"postTitle": {
			"type": "string"
		},
		"postUrl": {
			"type": "string"
		}
	},
	"supports": {
		"html": false
	},
	"textdomain": "dmg-read-more",
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css"
}
